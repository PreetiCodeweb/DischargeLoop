{
  "name": "@dischargeloop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "migrate": "node scripts/migrate.mjs",
    "migrate:down": "node scripts/migrate-down.mjs",
    "expire:reservations": "node dist/expire-reservations.js",
    "ttl:cleanup": "node dist/ttl-cleanup.js",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "jose": "^6.1.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "redis": "^4.7.0",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^6.0.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.0"
  }
}
