# DischargeLoop local stack configuration. Compose reads `.env` from the repository root.
# Create it with generated secrets:  ./scripts/init-env.sh
# `.env` is git-ignored. Never commit real values. Use URL-safe secrets (letters, digits, - and _).

# Database roles (applied when the pgdata volume is first created).
DL_POSTGRES_PASSWORD=
DL_APP_DB_PASSWORD=
DL_MIGRATION_DB_PASSWORD=

# JWT signing key and the shared secret the interface engine (Mirth/Redox) uses for POST /api/v1/integrations/hl7.
DL_SECRET_KEY=
DL_HL7_INGEST_TOKEN=

# Seeded local administrator (6-72 characters).
DL_ADMIN_USERNAME=roselyn_yu
DL_ADMIN_EMAIL=roselyn_yu@northstar.example
DL_ADMIN_PASSWORD=

# Synthetic demo: wards, beds, 12 synthetic patients and ward-4A/5B staff accounts
# (doctor.4a@, nurse.4a@, cm.4a@, pharm.4a@, evs1.4a@, evs2.4a@, transport.4a@, beds@ — all @northstar.example).
# Leave DL_DEMO_USER_PASSWORD empty to create no demo staff accounts. Set DL_SEED_DEMO=false for a clean install.
DL_SEED_DEMO=true
DL_DEMO_USER_PASSWORD=

# Host ports (bound to 127.0.0.1 only). Defaults avoid the MedSync stack on 3000/8000/5433.
DL_HTTP_PORT=3001
DL_API_PORT=8001
DL_DB_PORT=5434

# Frontend image recipe. Use Dockerfile.prebuilt when registry.npmjs.org is blocked
# (run scripts/build-frontend-prebuilt.sh before `docker compose build`).
DL_FRONTEND_DOCKERFILE=Dockerfile

DL_WORKER_INTERVAL_SECONDS=60
