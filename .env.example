# Copy to .env for local development. No secrets are committed here.
POSTGRES_DB=dischargeloop
POSTGRES_USER=dischargeloop
POSTGRES_PASSWORD=change-this-local-admin-password
POSTGRES_PORT=5432
APP_DB_USER=dischargeloop_app
APP_DB_PASSWORD=change-this-local-app-password
MIGRATION_DB_USER=dischargeloop_migrator
MIGRATION_DB_PASSWORD=change-this-local-migration-password

REDIS_PORT=6379
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-password
KEYCLOAK_PUBLIC_URL=http://localhost:8080

API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://dischargeloop_app:change-this-local-app-password@postgres:5432/dischargeloop?options=-csearch_path%3Ddischargeloop
MIGRATION_DATABASE_URL=postgresql://dischargeloop_migrator:change-this-local-migration-password@postgres:5432/dischargeloop?options=-csearch_path%3Ddischargeloop
REDIS_URL=redis://redis:6379
OIDC_ISSUER_URL=http://localhost:8080/realms/dischargeloop
OIDC_JWKS_URL=http://keycloak:8080/realms/dischargeloop/protocol/openid-connect/certs
OIDC_AUDIENCE=dischargeloop-api
